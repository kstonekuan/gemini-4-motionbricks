# Copy to .env for local development and supply your own Gemini API key.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL=your-accessible-model-id

# Optional server settings (CLI flags take priority).
# MOTIONBRICKS_HOST=127.0.0.1
# MOTIONBRICKS_PORT=6090
# MOTIONBRICKS_ASSETS=/absolute/path/to/web/dist

# Set false to plan from structured geometry without rendered images.
# MOTIONBRICKS_SCENE_IMAGES=true
